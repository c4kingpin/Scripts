# Central DevBox version manifest.
#
# This is the source of truth for every actively managed tool version.
# install.sh must remain a single, standalone, curl-pipeable file, so it
# carries its own copies of these values as defaults (overridable via the
# matching environment variable, e.g. `ERLANG_VERSION=28.4 bash install.sh`).
# devbox/tests/test-devbox.sh asserts install.sh's embedded defaults and the
# devbox manager's embedded copies never drift from this file.

DEVBOX_VERSION="1.6.0-RC2"

NODE_VERSION="24"

ERLANG_VERSION="29.0.5"
ELIXIR_VERSION="1.20.3"
PHOENIX_VERSION="1.8.9"

CODEX_VERSION="0.147.0"
CLAUDE_VERSION="2.1.233"
HAPPY_VERSION="1.2.0"
KISUKE_VERSION="1.2.20"
MULTICA_VERSION="0.4.32"
OPENCODE_VERSION="2.1.2"
OPENCHAMBER_VERSION="2.5.0"
CLOUDCLI_VERSION="1.37.5"
PLAYWRIGHT_VERSION="1.64.1"
TASKMASTER_VERSION="0.43.1"

CODE_SERVER_VERSION="4.141.0"
PROJECTATLAS_VERSION="0.4.5"
