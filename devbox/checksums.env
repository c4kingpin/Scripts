# Known-good SHA256 checksums for versioned binary artifacts fetched by
# install.sh, keyed by artifact/version/OS/arch. This is the source of truth;
# install.sh carries a matching copy in the DEVBOX_CHECKSUMS associative
# array (kept in sync and checked by devbox/tests/test-devbox.sh) so it
# remains a single, standalone, curl-pipeable file.
#
# Regenerate a value with:
#   curl -fsSL <artifact-url> | sha256sum
#
# Ubuntu 20.04 has no prebuilt Erlang/OTP 29.0.5 artifact on builds.hex.pm
# (upstream 404), so install.sh's OS check (#18-P2.2) rejects 20.04 outright
# rather than let the default profile fail later at download time.

OTP_29_0_5_UBUNTU_24_04_AMD64_SHA256="1ecf8a20104afa053e6701e36ec1485cbce1a2fa4aef962d5e73f9eb5c6e9fc0"
